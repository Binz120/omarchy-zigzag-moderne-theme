# Zigzag Moderne: btop.
#
# Box outlines are warm charcoal, so the data is the only thing that glows:
# gold for structure and throughput, brass and foil for the warm side of every
# gradient, patina for the cool side. Verdigris is absent on purpose: a
# monitor is a measurement, not a success state.

theme[main_bg]="#0A0A0B"
theme[main_fg]="#E8DFC8"
theme[title]="#C9A227"
theme[hi_fg]="#C9A227"

theme[selected_bg]="#2A2620"
theme[selected_fg]="#F2E8D5"
theme[inactive_fg]="#8A8168"
theme[graph_text]="#B9AE93"

theme[meter_bg]="#2A2620"
theme[proc_misc]="#B9AE93"

theme[cpu_box]="#2A2620"
theme[mem_box]="#2A2620"
theme[net_box]="#2A2620"
theme[proc_box]="#2A2620"
theme[div_line]="#2A2620"

theme[temp_start]="#A8862B"
